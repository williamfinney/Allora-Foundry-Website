---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { assertLaunchReady, site } from "../content/site";

interface Props {
  title: string;
  description: string;
  isHome?: boolean;
  /** Pages without a full-height hero start with the header already solid. */
  solidHeader?: boolean;
  /** Extra structured data for this page. */
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}

const { title, description, isHome = false, solidHeader = true, jsonLd, noindex } = Astro.props;

assertLaunchReady();

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL("/og-image.png", Astro.site).href;
---

<!doctype html>
<html lang="en" class:list={{ "is-scrolled": solidHeader }}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="google-site-verification" content={site.googleSiteVerification} />
    <meta name="theme-color" content="#f6f5f0" />

    <link
      rel="preload"
      href="/fonts/newsreader-latin-wght.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/instrument-sans-latin-wght.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Allora Foundry" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <slot name="background" />
    <Header isHome={isHome} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  import "../scripts/page";
</script>
