---
/**
 * The Allora mark (two overlapping squares rotated 45°, same geometry as the original logo)
 * paired with a wordmark set in the site's sans. Colors follow `--mark-dark` / `--mark-light`
 * so the logo can sit on Paper or Forest.
 */
interface Props {
  /** Render the wordmark next to the mark. */
  wordmark?: boolean;
  class?: string;
}

const { wordmark = true, class: className } = Astro.props;
---

<span class:list={["logo", className]}>
  <svg class="logo-mark" viewBox="-4 -4 148 148" aria-hidden="true" focusable="false">
    <rect
      class="logo-dark"
      x="15"
      y="15"
      width="90"
      height="90"
      rx="6"
      transform="rotate(45 60 60)"
    ></rect>
    <rect
      class="logo-light"
      x="55"
      y="55"
      width="70"
      height="70"
      rx="6"
      transform="rotate(45 90 90)"
    ></rect>
  </svg>
  {wordmark && <span class="logo-word">Allora Foundry</span>}
</span>

<style>
  .logo {
    --mark-dark: var(--forest);
    --mark-light: var(--sage);
    display: inline-flex;
    align-items: center;
    gap: 0.625em;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
    line-height: 1;
    white-space: nowrap;
  }

  .logo-mark {
    width: 1.75em;
    height: 1.75em;
    flex: none;
  }

  .logo-dark {
    fill: var(--mark-dark);
    transition: fill var(--dur-reveal) var(--ease);
  }

  .logo-light {
    fill: var(--mark-light);
  }
</style>
