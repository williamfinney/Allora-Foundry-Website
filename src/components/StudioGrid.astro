---
import type { Product } from "../content/site";

interface Props {
  products: Product[];
}

const { products } = Astro.props;
const featured = products.filter((p) => p.screenshot);
const standard = products.filter((p) => !p.screenshot);
// Empty cells complete the last row so the hairline grid stays whole and the dot field shows through.
// The grid is 2 columns on tablets and 3 on desktop, so each empty cell knows where it is needed.
const fill = (columns: number): number => (columns - (standard.length % columns)) % columns;
const emptyCells = Array.from({ length: Math.max(fill(2), fill(3)) }, (_, i) => ({
  inTwo: i < fill(2),
  inThree: i < fill(3),
}));
---

<div class="studio-grid">
  {featured.map((product, i) => (
    <a
      class:list={["cell", "featured", { "featured-right": i % 2 === 1 }]}
      href={product.href}
      target="_blank"
      rel="noopener"
      data-reveal
    >
      {product.screenshot && (
        <img
          class="featured-shot"
          src={product.screenshot.src}
          alt={product.screenshot.alt}
          width={product.screenshot.width}
          height={product.screenshot.height}
          loading="lazy"
          decoding="async"
        />
      )}
      <span class="cell-body">
        <span class="cell-category eyebrow">{product.category}</span>
        <span class="cell-name">{product.name}</span>
        <span class="cell-line">{product.line}</span>
        <span class="cell-status small">{product.status}</span>
      </span>
      <span class="visually-hidden"> (opens in a new tab)</span>
    </a>
  ))}
  {standard.map((product) => (
    <a class="cell" href={product.href} target="_blank" rel="noopener" data-reveal>
      <span class="cell-body">
        <span class="cell-category eyebrow">{product.category}</span>
        <span class="cell-name">{product.name}</span>
        <span class="cell-line">{product.line}</span>
        <span class="cell-status small">{product.status}</span>
      </span>
      <span class="visually-hidden"> (opens in a new tab)</span>
    </a>
  ))}
  {emptyCells.map((cell) => (
    <div
      class:list={["cell", "empty", { "in-two": cell.inTwo, "in-three": cell.inThree }]}
      aria-hidden="true"
    />
  ))}
</div>

<style>
  .studio-grid {
    display: grid;
    grid-template-columns: 1fr;
    grid-auto-flow: dense;
    border-top: 1px solid var(--cell-rule);
    border-left: 1px solid var(--cell-rule);
    transition: border-color var(--dur-reveal) var(--ease);
  }

  .cell {
    position: relative;
    display: flex;
    min-height: 18rem;
    padding: var(--space-8) var(--space-6);
    border-right: 1px solid var(--cell-rule);
    border-bottom: 1px solid var(--cell-rule);
    color: inherit;
    transition:
      background-color var(--dur-hover) var(--ease),
      border-color var(--dur-reveal) var(--ease),
      color var(--dur-hover) var(--ease);
  }

  .cell.empty {
    display: none;
  }

  .cell-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: auto;
  }

  .cell-category {
    color: var(--cell-muted);
    transition: color var(--dur-hover) var(--ease);
  }

  .cell-name {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 2.4vw, 2.25rem);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .cell-line {
    max-width: 36ch;
  }

  .cell-status {
    color: var(--cell-muted);
    transition: color var(--dur-hover) var(--ease);
  }

  a.cell:hover,
  a.cell:focus-visible {
    background-color: var(--sage);
    color: var(--forest);
  }

  a.cell:hover .cell-category,
  a.cell:hover .cell-status,
  a.cell:focus-visible .cell-category,
  a.cell:focus-visible .cell-status {
    color: var(--forest);
  }

  a.cell:focus-visible {
    outline-color: currentColor;
    outline-offset: -4px;
  }

  .featured {
    flex-direction: column;
    gap: var(--space-8);
  }

  .featured-shot {
    width: 100%;
    max-width: 22rem;
  }

  @media (min-width: 768px) {
    .studio-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .cell.empty.in-two {
      display: block;
    }

    .featured {
      grid-column: span 2;
      grid-row: span 2;
      flex-direction: row;
      align-items: flex-end;
    }

    .featured-right {
      flex-direction: row-reverse;
    }
  }

  @media (min-width: 1024px) {
    .studio-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .cell.empty {
      display: none;
    }

    .cell.empty.in-three {
      display: block;
    }

    .cell {
      min-height: 22rem;
      padding: var(--space-10) var(--space-8);
    }
  }
</style>
