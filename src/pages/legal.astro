---
import BaseLayout from "../layouts/BaseLayout.astro";
import { legal, pages } from "../content/site";

const updated = new Date(`${legal.updated}T00:00:00Z`).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
---

<BaseLayout title={pages.legal.title} description={pages.legal.description}>
  <div class="section legal">
    <div class="container grid">
      <header class="legal-head">
        <h1 class="display">Legal</h1>
        <nav aria-label="Legal documents">
          <ul class="legal-jump">
            {legal.documents.map((doc) => (
              <li>
                <a class="link" href={`#${doc.id}`}>
                  {doc.title}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <p class="small muted">
          Last updated: <time datetime={legal.updated}>{updated}</time>
        </p>
      </header>
      {legal.documents.map((doc) => (
        <section id={doc.id} class="legal-doc" aria-labelledby={`${doc.id}-title`}>
          <h2 id={`${doc.id}-title`} class="h2">
            {doc.title}
          </h2>
          <p>{doc.intro}</p>
          {doc.sections.map((section) => (
            <>
              <h3 class="legal-heading">{section.heading}</h3>
              <p set:html={section.html} />
            </>
          ))}
        </section>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .legal {
    padding-top: calc(var(--header-h) + var(--section-pad) * 0.6);
  }

  .legal-head,
  .legal-doc {
    grid-column: 1 / -1;
  }

  .legal-head {
    display: grid;
    gap: var(--space-6);
    margin-bottom: var(--space-16);
  }

  .legal-jump {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
  }

  .legal-doc {
    display: grid;
    gap: var(--space-4);
    max-width: 68ch;
    padding-top: var(--space-12);
    border-top: 1px solid var(--rule);
  }

  .legal-doc + .legal-doc {
    margin-top: var(--space-20);
  }

  .legal-doc h2 {
    margin-bottom: var(--space-4);
  }

  .legal-heading {
    margin-top: var(--space-6);
    font-weight: 500;
  }

  @media (min-width: 1024px) {
    .legal-doc {
      grid-column: 4 / span 7;
    }
  }
</style>
